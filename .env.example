# Sumalyze — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.

# ─── Supabase (Client-safe — VITE_ prefix exposes to browser) ───────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── App Config (Client-safe) ────────────────────────────────────────────────
VITE_APP_ENV=development
# VITE_KOFI_URL=https://ko-fi.com/sumalyze   (hardcoded for now, add here if dynamic)

# ─── PostHog Analytics (Client-safe — VITE_ prefix exposes to browser) ───────
# Set to "true" to enable analytics tracking.
VITE_ENABLE_ANALYTICS=false
VITE_POSTHOG_KEY=your_posthog_project_api_key_here
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Maintenance Mode ─────────────────────────────────────────────────────────
# Set to "true" to show the maintenance page and block the entire app.
# Set to "false" (or leave unset) for normal operation.
VITE_MAINTENANCE_MODE=true

# ─── AI Provider (SERVER-SIDE ONLY — never use VITE_ prefix for secrets) ────
# Used in: netlify/functions/analyze.ts
# NEVER expose these to the browser.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Alternative AI provider (future use)
# AI_PROVIDER_API_KEY=your-alternate-provider-key

# ─── Supabase Service Role (SERVER-SIDE ONLY) ────────────────────────────────
# Used for: saving analysis history, user profile updates, admin operations
# NEVER use VITE_ prefix on this key. Never import it in any src/ file.
# Only use in netlify/functions/ or a backend server.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ─── Future Integrations ─────────────────────────────────────────────────────
# SENDGRID_API_KEY=        (for email notifications)
# STRIPE_SECRET_KEY=       (for future paid plans — server-side only)
# WEBHOOK_SECRET=          (for verifying incoming webhooks)

# ─── Upstash Redis Rate Limiting (SERVER-SIDE ONLY) ───────────────────────────
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
ENABLE_RATE_LIMITS=true

# ─── Resend Transactional Email (SERVER-SIDE ONLY) ───────────────────────────
# Used in: netlify/functions/send-feedback.ts
# NEVER expose these to the browser.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Sumalyze <no-reply@sumalyze.space>
RESEND_SUPPORT_TO=support@sumalyze.space
RESEND_INFO_TO=info@sumalyze.space
RESEND_BILLING_TO=billing@sumalyze.space
RESEND_PRIVACY_TO=privacy@sumalyze.space

# ─── Cloudflare Turnstile Bot Protection ─────────────────────────────────────
# Frontend visible site key
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
# Server-side only secret key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
# Set to "true" to allow test suite bypass
ALLOW_TURNSTILE_BYPASS=false

# ─── Future Paddle Integration (SANDBOX ONLY) ────────────────────────────────
VITE_PADDLE_CLIENT_TOKEN=your_paddle_client_token_here
VITE_PADDLE_ENV=sandbox
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here

# Paddle Price IDs for Tiers
VITE_PADDLE_PRICE_STARTER_MONTHLY=pri_starter_monthly
VITE_PADDLE_PRICE_STARTER_ANNUAL=pri_starter_annual
VITE_PADDLE_PRICE_PRO_MONTHLY=pri_pro_monthly
VITE_PADDLE_PRICE_PRO_ANNUAL=pri_pro_annual
VITE_PADDLE_PRICE_MAX_MONTHLY=pri_max_monthly
VITE_PADDLE_PRICE_MAX_ANNUAL=pri_max_annual

