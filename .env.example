# ─────────────────────────────────────────────────────────────
# Sumalyze — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# Supabase — get these from https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
# ⚠ NEVER add SUPABASE_SERVICE_ROLE_KEY to frontend env

# PostHog — add later
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxx
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# AI Engine — add later (must go through server-side function)
# VITE_OPENAI_API_KEY=sk-xxxxxxxxxxxx

# ─── App Config ───────────────────────────────────────────────
