# Sumalyze — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.

# ─── Supabase (Client-safe — VITE_ prefix exposes to browser) ───────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── App Config (Client-safe) ────────────────────────────────────────────────
VITE_APP_ENV=development
# VITE_KOFI_URL=https://ko-fi.com/sumalyze   (hardcoded for now, add here if dynamic)

# ─── Maintenance Mode ─────────────────────────────────────────────────────────
# Set to "true" to show the maintenance page and block the entire app.
# Set to "false" (or leave unset) for normal operation.
VITE_MAINTENANCE_MODE=false

# ─── AI Provider (SERVER-SIDE ONLY — never use VITE_ prefix for secrets) ────
# Used in: netlify/functions/analyze.ts
# NEVER expose these to the browser.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Alternative AI provider (future use)
# AI_PROVIDER_API_KEY=your-alternate-provider-key

# ─── Supabase Service Role (SERVER-SIDE ONLY) ────────────────────────────────
# Used for: saving analysis history, user profile updates, admin operations
# NEVER use VITE_ prefix on this key. Never import it in any src/ file.
# Only use in netlify/functions/ or a backend server.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ─── Future Integrations ─────────────────────────────────────────────────────
# SENDGRID_API_KEY=        (for email notifications)
# STRIPE_SECRET_KEY=       (for future paid plans — server-side only)
# WEBHOOK_SECRET=          (for verifying incoming webhooks)

# ─── Upstash Redis (SERVER-SIDE ONLY — persistent rate limits) ───────────────
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

