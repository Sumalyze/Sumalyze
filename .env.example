# ─────────────────────────────────────────────────────────────────────────────
# Sumalyze — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED for auth) ─────────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
# ⚠ NEVER add SUPABASE_SERVICE_ROLE_KEY here — server-side use only

# ── OpenAI (OPTIONAL — enables real AI analysis) ─────────────────────────────
# Get from: https://platform.openai.com/api-keys
# If missing, app returns a mock result. Safe to omit for initial launch.
# Uses gpt-4o-mini — cheap and fast.
OPENAI_API_KEY=sk-...
# ⚠ No VITE_ prefix — this is server-side only (api/analyze.ts), never exposed to browser

# ── PostHog Analytics (OPTIONAL — add after launch) ──────────────────────────
# Get from: https://eu.posthog.com → Project → Settings
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ── App Info (reference only — not loaded by code) ───────────────────────────
# Production domain: https://sumalyze.space
# Contact email:     hello@sumalyze.space
# Ko-fi support:     https://ko-fi.com/sumalyze
# Supabase password reset redirect: https://sumalyze.space/

# ── Hosting Environment Variables to add on Vercel / Netlify ─────────────────
# VITE_SUPABASE_URL         → required
# VITE_SUPABASE_ANON_KEY    → required
# OPENAI_API_KEY            → optional (enables real AI)
